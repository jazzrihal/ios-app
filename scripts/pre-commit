#!/usr/bin/env bash
# Pre-commit hook: runs SwiftFormat (auto-fix) and SwiftLint (lint) on staged .swift files.
# Install with: ./scripts/install-hooks.sh

set -euo pipefail

# Collect staged Swift files (Added, Copied, Modified, Renamed)
STAGED_SWIFT_FILES=$(git diff --cached --name-only --diff-filter=ACMR -- '*.swift' || true)

if [ -z "$STAGED_SWIFT_FILES" ]; then
  exit 0
fi

# ─────────────────────────── SwiftFormat ─────────────────────────
if command -v swiftformat >/dev/null 2>&1; then
  echo "Running SwiftFormat on staged files..."
  while IFS= read -r file; do
    if [ -f "$file" ]; then
      swiftformat "$file" --config .swiftformat --quiet
      git add "$file"  # re-stage after formatting
    fi
  done <<< "$STAGED_SWIFT_FILES"
else
  echo "warning: SwiftFormat not installed — skipping auto-format. Install with: brew install swiftformat"
fi

# ──────────────────────────── SwiftLint ──────────────────────────
if command -v swiftlint >/dev/null 2>&1; then
  echo "Running SwiftLint on staged files..."
  LINT_FAILED=false
  while IFS= read -r file; do
    if [ -f "$file" ]; then
      if ! swiftlint lint --config .swiftlint.yml --path "$file" --quiet; then
        LINT_FAILED=true
      fi
    fi
  done <<< "$STAGED_SWIFT_FILES"

  if [ "$LINT_FAILED" = true ]; then
    echo ""
    echo "SwiftLint found violations. Fix them before committing."
    echo "Run 'make lint' to see all issues, or 'make lint-fix' to auto-correct."
    exit 1
  fi
else
  echo "warning: SwiftLint not installed — skipping lint. Install with: brew install swiftlint"
fi

exit 0
